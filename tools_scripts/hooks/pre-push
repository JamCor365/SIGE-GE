#!/bin/bash
# Pre-push hook — aborta el push si hay referencias a IA en archivos rastreados
# o en commits nuevos (los que aún no están en el remoto).
#
# Instalación: bash tools_scripts/install-hooks.sh

PATTERN="clau""de|anthrop""ic|chatg""pt|open""ai|cop""ilot|ai-gen""erated|co-auth""ored-by|noreply@anthrop""ic\.com|agentes ia"

echo "[pre-push] Verificando referencias a IA..."

# 1. Archivos rastreados por git (excluye los propios scripts de verificación)
dirty=$(git ls-files \
    | grep -v "^tools_scripts/check-ai-refs\.sh$" \
    | grep -v "^tools_scripts/hooks/" \
    | grep -v "^tools_scripts/install-hooks\.sh$" \
    | xargs grep -ilE "$PATTERN" 2>/dev/null)
if [ -n "$dirty" ]; then
    echo "[pre-push] BLOQUEADO — referencias en archivos del repo:"
    echo "$dirty"
    exit 1
fi

# 2. Commits nuevos (los que este push llevaría al remoto)
# stdin del hook: "<local-ref> <local-sha> <remote-ref> <remote-sha>"
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    bad=$(git log "$range" \
        --format='%H%nAuthor: %an <%ae>%nCommitter: %cn <%ce>%n%B%n---' 2>/dev/null \
        | grep -iE "$PATTERN")

    if [ -n "$bad" ]; then
        echo "[pre-push] BLOQUEADO — referencias en commits nuevos:"
        echo "$bad"
        exit 1
    fi
done

echo "[pre-push] OK — sin referencias a IA. Push permitido."
exit 0
